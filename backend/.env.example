# Gestiva Backend — environment variables
# Copiar a .env y completar.

# Server
PORT=3100
JWT_SECRET=cambiame-en-prod-con-algo-largo-y-random

# Database (PostgreSQL)
DATABASE_URL=postgres://user:pass@host:5432/gestiva

# MercadoPago (TEST credentials)
# Sacar de https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxx
MP_TEST_MODE=1

# URLs
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:3100

# Pricing
SUB_PRICE_ARS=40000
GRACE_DAYS=7
