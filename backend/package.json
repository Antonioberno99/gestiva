    "test": "node scripts/test-facturacion.js && node scripts/test-circuito.js && node scripts/test-comandera.js && node scripts/test-cobro.js",
    "test:cobro": "node scripts/test-cobro.js",
    "test:facturacion": "node scripts/test-facturacion.js",
