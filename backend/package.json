{
  "name": "gestiva-backend",
  "version": "1.0.0",
  "description": "Gestiva SaaS backend — auth + MercadoPago subscriptions + multi-tenant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:render": "node scripts/migrate.js && node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node scripts/migrate.js",
    "test:circuito": "node scripts/test-circuito.js",
