  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.15",
    "node-forge": "^1.3.1",
    "pg": "^8.11.5",
    "uuid": "^9.0.1"
